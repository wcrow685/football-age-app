{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "howmanyfootballplayersolderthanme.com"
        }
      ],
      "destination": "https://www.howmanyfootballplayersolderthanme.com/$1",
      "permanent": true
    },
    {
      "source": "/player/bahad-305-r-han-gungordu",
      "destination": "/player/bahadir-han-gungordu",
      "permanent": true
    },
    {
      "source": "/player/ibrahim-alk-305-s",
      "destination": "/player/ibrahim-alkis",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/players.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "{public/players.json,public/fonts/**}"
    }
  }
}
